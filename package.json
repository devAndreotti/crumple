{
  "name": "@devandreotti/crumple",
  "version": "1.2.0",
  "description": "Crumpled paper you can open: a dependency-free WebGL2 library that flies a crumpled note to the center of the screen and unfolds it into a readable sheet.",
  "keywords": [
    "paper",
    "crumple",
    "crumpled-paper",
    "webgl",
    "webgl2",
    "animation",
    "unfold",
    "letter",
    "note",
    "3d"
  ],
  "homepage": "https://devandreotti.github.io/crumple/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devAndreotti/crumple.git"
  },
  "bugs": "https://github.com/devAndreotti/crumple/issues",
  "license": "MIT",
  "author": "devAndreotti",
  "type": "module",
  "main": "dist/crumple.cjs",
  "module": "dist/crumple.esm.js",
  "unpkg": "dist/crumple.min.js",
  "jsdelivr": "dist/crumple.min.js",
  "types": "crumple.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./crumple.d.ts",
        "default": "./dist/crumple.esm.js"
      },
      "require": {
        "types": "./dist/crumple.d.cts",
        "default": "./dist/crumple.cjs"
      }
    },
    "./package.json": "./package.json",
    "./assets/*": "./assets/*"
  },
  "files": [
    "dist",
    "assets",
    "crumple.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "assets": "python3 tools/make-assets.py",
    "serve": "python3 -m http.server 8080 --directory docs",
    "prerender": "node tools/prerender.cjs docs/papers.json docs/snaps",
    "test": "npm run test:node && npm run test:browser",
    "test:node": "node --test tests/node.test.mjs",
    "test:browser": "node tests/smoke.cjs && node tests/flow.cjs && node tests/robust.cjs && node tests/burnflip.cjs && node tests/states.cjs && node tests/shapes.cjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "puppeteer-core": "25.16.0"
  }
}
